# ─────────────────────────────────────────────────────────────
# NeedleDrop — environment template
# Copy to `.env.local` and fill in. Never commit the real file.
#
# The app boots with NONE of these set and runs in demo mode against the
# built-in catalogue. Every variable below is optional except the two
# marked REQUIRED IN PRODUCTION.
# ─────────────────────────────────────────────────────────────

# ── Required in production ──────────────────────────────────

# Google OAuth client (APIs & Services → Credentials → Web app)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# 32-byte hex string — generate with: openssl rand -hex 32
# REQUIRED IN PRODUCTION — the session cookie cannot be encrypted without it.
SESSION_SECRET=replace_me_with_64_hex_chars

# Public origin of this deployment. Also the OAuth redirect origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Discovery ───────────────────────────────────────────────

# YouTube Data API v3 key. Unset ⇒ the offline demo catalogue is used.
YOUTUBE_API_KEY=

# ── Optional ────────────────────────────────────────────────

# Enable the optional Postgres store (runs/presets/blocks/feedback).
# App works without it — an in-memory store takes over.
# DATABASE_URL=postgres://user:pass@host:5432/needledrop
# A Supabase/PostgREST URL works too:
# DATABASE_URL=https://xxxx.supabase.co/rest/v1
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Enable the Redis cache (discovery cache + rate limiting).
# Unset ⇒ an in-process LRU with the same TTLs is used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Durable job runner for playlist creation.
# Unset ⇒ the in-process job queue is used.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# User-supplied YouTube API keys are NOT environment variables.
# A visitor sets one in the UI; it is verified, then stored encrypted in
# that browser's cookie, and it spends the visitor's own quota instead of
# the shared one. There is deliberately no NEXT_PUBLIC_ variant: a
# NEXT_PUBLIC_ value is inlined into the client bundle and would be
# published to every visitor.

# Digests & transactional email.
# RESEND_API_KEY=

# ── Feature flags (PLAN §13.10) ─────────────────────────────
# ENGINE_VERSION=v1|v2          # v1 = the old single-seed engine, v2 = the centroid engine
# DISCOVERY_DEPTH=1|2           # 2 = two hops from the seed
# CACHE_ENABLED=true|false
# JOBS_ENABLED=true|false
# PERSISTENCE_ENABLED=true|false

# ── Quota governance (PLAN §13.7) ───────────────────────────
# DAILY_QUOTA=10000             # the YouTube project quota
# GLOBAL_DAILY_CAP=9000         # our ceiling, deliberately below the project quota
# SESSION_DAILY_BUDGET=3000     # soft per-browser-session budget
# RATE_LIMIT_PER_MINUTE=30      # per-IP requests per minute, per route scope
