# ─────────────────────────────────────────────────────────────
# NeedleDrop — environment template
# Copy to `.env.local` and fill in. Never commit the real file.
# ─────────────────────────────────────────────────────────────

# Google OAuth client (APIs & Services → Credentials → Web app)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# 32-byte hex string — generate with: openssl rand -hex 32
SESSION_SECRET=replace_me_with_64_hex_chars

# Public origin of this deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────
# Enable the optional Postgres store (runs/presets/feedback). App works without it.
# DATABASE_URL=postgres://user:pass@host:5432/needledrop

# Enable the Redis cache (discovery cache + rate limiting).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Durable job runner for playlist creation.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# User-supplied YouTube API key to bypass the shared project quota (optional).
# Stored encrypted per session, never logged.
# YOUTUBE_API_KEY=

# Digests & transactional email.
# RESEND_API_KEY=
